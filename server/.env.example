# Copia este archivo como ".env" y completa los valores.
PORT=4000
NODE_ENV=development

# --- Administrador del panel (/#/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-larga
# Texto largo y aleatorio (mínimo 32 caracteres) para firmar las sesiones
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-123456

# --- Correo (opcional): los pedidos y mensajes llegan a tu email ---
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
MAIL_TO=tucorreo@gmail.com

# --- Guardado permanente de los cambios del panel (opcional, recomendado en hosting gratis) ---
# Los cambios se guardan como un "commit" en tu repositorio de GitHub (gratis).
# Crea un token en GitHub: Settings > Developer settings > Fine-grained tokens,
# con permiso "Contents: Read and write" SOLO sobre este repositorio.
GITHUB_TOKEN=
GITHUB_REPO=tu-usuario/digital-control
GITHUB_BRANCH=main
GITHUB_PATH=shared/catalog.seed.json

# --- Opcional ---
# CORS_ORIGIN=https://tu-sitio-estatico.pages.dev   (solo si el frontend está en otro dominio)
# DATA_DIR=/ruta/a/un/disco/persistente
